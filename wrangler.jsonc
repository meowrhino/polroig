// La còpia de Pol, a Cloudflare: Workers Builds connectat al seu repo.
// Es publica a l'arrel; amb el domini a data/site.json → "url", s'indexa.
{
  "name": "polroig",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node build/build.mjs" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
