// Per quan la web passi a Cloudflare Workers (Workers Builds connectat al repo).
// Allà va amb domini propi: posa "domini" a data/site.json i BASE buida.
{
  "name": "polroig",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node build/build.mjs" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
